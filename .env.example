# Copia este archivo como .env y usa los mismos valores compartidos con Users.
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/eventpass_tickets
DB_USERNAME=postgres
DB_PASSWORD=

# Reemplazar por el mismo secreto Base64 configurado en Users.
JWT_SECRET_BASE64=REEMPLAZAR_POR_EL_SECRETO_COMPARTIDO_EN_BASE64
JWT_ISSUER=eventpass-users
